# MD2Short 환경 변수 템플릿.
# 이 파일을 `.env`로 복사한 뒤 값을 채운다. `.env`는 절대 커밋하지 않는다.
# 실제로 읽는 변수 이름은 src/md2short/config.py가 유일한 기준이다.

# [필수] ElevenLabs API 키 (TTS + Scribe STT 공용).
# config.get_elevenlabs_api_key()가 이 이름을 먼저 찾는다.
ELEVENLABS_API_KEY=sk_your_elevenlabs_api_key_here

# [선택 / legacy] 오타가 섞인 구 이름. ELEVENLABS_API_KEY가 없을 때만 fallback으로 쓰인다.
# 새로 설정한다면 위의 ELEVENLABS_API_KEY를 쓰고 이 줄은 비워 두면 된다.
# ELEVNLABS_API=sk_your_elevenlabs_api_key_here

# [필수] OpenAI API 키 (대본 생성 gpt-5-mini, --visual-mode photo의 gpt-image-2).
# 없으면 대본 단계가 fallback_extract로 내려가고 photo mode는 emoticon mode가 된다.
OPENAI_API_KEY=sk-your_openai_api_key_here

# [선택] 기본 voice id 오버라이드.
# schema.DEFAULT_VOICES["ko"]는 voice library 음성이라 무료 계정에서 HTTP 402
# paid_plan_required로 거절된다. 그런 계정은 여기에 premade 음성 id를 넣는다.
# CLI의 --voice 플래그가 이 값보다 우선한다. 자세한 내용은 docs/voice.md.
# ELEVENLABS_VOICE_ID=v1jVu1Ky28piIPEJqRrm
